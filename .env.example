# Ứng dụng
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=

# Registry JSON và hàng đợi local
REGISTRY_DATA_PATH=data/seed/services.example.json
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=zalo-navigator

# Tích hợp Zalo OA
# Xác minh endpoint và contract xác thực hiện hành trong tài liệu Zalo chính thức.
ZALO_API_BASE_URL=
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_APP_SECRET=
ZALO_WEBHOOK_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# Nhà cung cấp AI. Provider giả giúp môi trường local không cần credential thật.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
STT_PROVIDER=fake
STT_API_KEY=

# An toàn và vận hành
ALLOWED_LAUNCH_HOSTS=
AUDIO_RETENTION_SECONDS=900
UID_HASH_SALT=
SENTRY_DSN=
