# Ứng dụng
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=

# Registry thật đã review và hàng đợi
REGISTRY_DATA_PATH=data/registry/services.real.json
RAG_DATA_PATH=data/rag/service-catalog.sqlite3
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=zalo-navigator

# Tích hợp Zalo OA
# Xác minh endpoint và contract xác thực hiện hành trong tài liệu Zalo chính thức.
ZALO_API_BASE_URL=
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_APP_SECRET=
ZALO_WEBHOOK_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# Nhà cung cấp AI thật. Chỉ đặt key đã rotate trong .env, không commit.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Khóa riêng bảo vệ toàn bộ /api/v1/*; dùng chuỗi ngẫu nhiên ít nhất 16 ký tự.
NAVIGATOR_API_KEY=
NAVIGATOR_MAX_CONCURRENCY=4
NAVIGATOR_QUEUE_TIMEOUT_SECONDS=0.1

# Voice chưa bật trong sprint hiện tại.
STT_PROVIDER=disabled
STT_API_KEY=

# An toàn và vận hành
ALLOWED_LAUNCH_HOSTS=zalo.me,oa.zalo.me,www.vio.edu.vn,www.matsaigon.com,cskh.evnhcmc.vn
AUDIO_RETENTION_SECONDS=900
UID_HASH_SALT=
SENTRY_DSN=
