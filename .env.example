# Ứng dụng
APP_ENV=local
ENABLE_DOCS=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=

# Registry thật đã review và hàng đợi
REGISTRY_DATA_PATH=data/registry/services.real.json
RAG_DATA_PATH=data/rag/service-catalog.sqlite3
# `json` giữ fallback an toàn cho test; production Compose dùng `postgres`.
SEARCH_BACKEND=postgres
DATABASE_URL=postgresql://navigator:navigator-local-only@localhost:5432/navigator
# URL nội bộ Docker Compose; không dùng `localhost` vì API chạy trong container khác.
COMPOSE_DATABASE_URL=postgresql://navigator:navigator-local-only@postgres:5432/navigator
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Chỉ bật sau khi đã seed embeddings bằng `make catalog-embed`.
SEMANTIC_SEARCH_ENABLED=false
POSTGRES_DB=navigator
POSTGRES_USER=navigator
POSTGRES_PASSWORD=navigator-local-only
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=zalo-navigator

# Tích hợp Zalo OA
# Xác minh endpoint và contract xác thực hiện hành trong tài liệu Zalo chính thức.
ZALO_API_BASE_URL=
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_APP_SECRET=
ZALO_WEBHOOK_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
# Thử nghiệm template list V2. Giữ false cho tới khi test với UID nội bộ.
ZALO_LIST_TEMPLATE_ENABLED=false
# Ảnh HTTPS dạng JPG/PNG dùng chung cho card; có thể để trống để test list không ảnh.
ZALO_LIST_IMAGE_URL=

# Nhà cung cấp AI thật. Chỉ đặt key đã rotate trong .env, không commit.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Khóa riêng bảo vệ toàn bộ /api/v1/*; dùng chuỗi ngẫu nhiên ít nhất 16 ký tự.
NAVIGATOR_API_KEY=
NAVIGATOR_MAX_CONCURRENCY=4
NAVIGATOR_QUEUE_TIMEOUT_SECONDS=0.1

# Voice API là opt-in. Audio được xử lý trong bộ nhớ và không được lưu lại.
STT_PROVIDER=disabled
STT_API_KEY=
STT_MODEL=gemini-3.6-flash
STT_TIMEOUT_SECONDS=20
STT_MAX_RETRIES=1
STT_MAX_CONCURRENCY=2
STT_QUEUE_TIMEOUT_SECONDS=0.1
TTS_PROVIDER=disabled
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_TIMEOUT_SECONDS=15
TTS_MAX_RETRIES=1
TTS_MAX_CONCURRENCY=2
TTS_QUEUE_TIMEOUT_SECONDS=0.1

# An toàn và vận hành
ALLOWED_LAUNCH_HOSTS=zalo.me
AUDIO_RETENTION_SECONDS=900
UID_HASH_SALT=
SENTRY_DSN=
